{
    "name": "mydnic/volet",
    "description": "A fully featured feedback component for Laravel, gather user feedbacks, chat, etc",
    "keywords": [
        "Mydnic",
        "volet",
        "laravel-volet"
    ],
    "homepage": "https://github.com/mydnic/volet",
    "license": "MIT",
    "authors": [
        {
            "name": "Clément Rigo",
            "email": "rigoclement@mydnic.be",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^10.0||^11.0||^12.0||^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.1.1||^7.10.0",
        "orchestra/testbench": "^10.1.0||^11.0",
        "pestphp/pest": "^3.0||^4.4",
        "pestphp/pest-plugin-arch": "^3.0||^4.0",
        "pestphp/pest-plugin-laravel": "^3.0||^4.1"
    },
    "autoload": {
        "psr-4": {
            "Mydnic\\Volet\\": "src/",
            "Mydnic\\Volet\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mydnic\\Volet\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php ./vendor/bin/testbench package:discover --ansi"
        ],
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mydnic\\Volet\\VoletServiceProvider"
            ],
            "aliases": {
                "Volet": "Mydnic\\Volet\\Facades\\Volet"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
